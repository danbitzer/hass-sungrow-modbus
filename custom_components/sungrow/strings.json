{
  "title": "Sungrow SH-T Hybrid Inverter",
  "config": {
    "step": {
      "user": {
        "title": "Connect to the inverter",
        "description": "The WiNet-S dongle or LAN port speaks Modbus TCP. The inverter must be an SH-T model (SH5T to SH25T).",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit id"
        },
        "data_description": {
          "host": "IP address or hostname of the WiNet-S dongle.",
          "port": "Modbus TCP port, normally 502.",
          "unit_id": "Modbus unit (slave) id, normally 1."
        }
      },
      "reconfigure": {
        "title": "Change the connection",
        "description": "The inverter reached at the new address must have the same serial number.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit id"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not read the inverter's identity block.",
      "unsupported_model": "{model} ({code}) is not an SH-T inverter; only SH5T to SH25T are supported.",
      "no_serial": "The inverter reported no serial number."
    },
    "abort": {
      "already_configured": "This inverter is already configured.",
      "reconfigure_successful": "The connection was updated.",
      "wrong_device": "That address reaches a different inverter."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling and control",
        "data": {
          "realtime_interval": "Measurement poll interval",
          "settings_interval": "Settings poll interval",
          "battery_max_power_w": "Battery max power",
          "message_spacing_ms": "Gap between Modbus requests",
          "include_register_dump": "Include a register dump in diagnostics"
        },
        "data_description": {
          "realtime_interval": "Seconds between reads of the fast-changing measurements.",
          "settings_interval": "Seconds between reads of the settings, limits, energy counters and alarms.",
          "battery_max_power_w": "The charge/discharge limit restored by self-consumption mode; the value you run the battery at, not necessarily the inverter's rating.",
          "message_spacing_ms": "Milliseconds between requests to the dongle; never below 10.",
          "include_register_dump": "Diagnostics downloads read every register (the serial number is dropped)."
        }
      }
    }
  },
